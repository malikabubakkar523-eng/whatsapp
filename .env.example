# Database URL (PostgreSQL for production or SQLite for local dev)
DATABASE_URL="postgresql://postgres:password@localhost:5432/chatflow?schema=public"
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Generate a secure random string)
JWT_SECRET="your_production_secret_key_here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Object Storage (S3 / Cloudinary)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET_NAME=""

# Port
PORT=3000
