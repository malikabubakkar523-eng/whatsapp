# ==============================================================================
# Vercel & Production Environment Variables (Cloudflare D1 Database)
# ==============================================================================

# Cloudflare D1 Database Configuration (Add these in Vercel Project Settings -> Environment Variables)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_D1_DATABASE_ID="d4626968-e5c1-4ea0-acc5-c2c5ee09f3a2"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"

# JWT Authentication Secret (Required in Vercel)
JWT_SECRET="your_production_secret_key_minimum_32_characters"

# Base Application URL
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ==============================================================================
# Local Development Database Fallback
# ==============================================================================
DATABASE_URL="file:./prisma/dev.db"

# Optional Object Storage (S3 / Cloudinary)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET_NAME=""

PORT=3000
